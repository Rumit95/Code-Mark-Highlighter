{
  "name": "code-mark-highlighter",
  "displayName": "Code Mark Highlighter",
  "description": "Highlight code blocks with custom colors and tags. Highlights persist based on code content — not line numbers — and survive edits and restarts.",
  "version": "1.0.0",
  "publisher": "KSHYKR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rumit95/Code-Mark-Highlighter.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "highlight",
    "bookmark",
    "tags",
    "code",
    "navigator",
    "code mark"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "resources/devmarks-icon.png",
  "contributes": {
    "commands": [
      {
        "command": "codemark.highlightCode",
        "title": "Code Mark: Highlight Code",
        "category": "Code Mark"
      },
      {
        "command": "codemark.removeHighlight",
        "title": "Code Mark: Remove Highlight",
        "category": "Code Mark"
      },
      {
        "command": "codemark.editTag",
        "title": "Code Mark: Edit Highlight Tag",
        "category": "Code Mark"
      },
      {
        "command": "codemark.changeColor",
        "title": "Code Mark: Change Highlight Color",
        "category": "Code Mark"
      },
      {
        "command": "codemark.toggleHighlightBackground",
        "title": "Code Mark: Toggle Highlight Backgrounds",
        "category": "Code Mark"
      },
      {
        "command": "codemark.showPanel",
        "title": "Code Mark: Show Highlights Panel",
        "category": "Code Mark"
      },
      {
        "command": "codemark.nextHighlight",
        "title": "Code Mark: Next Highlight",
        "category": "Code Mark"
      },
      {
        "command": "codemark.prevHighlight",
        "title": "Code Mark: Previous Highlight",
        "category": "Code Mark"
      },
      {
        "command": "codemark.clearAllHighlights",
        "title": "Code Mark: Clear All Highlights in File",
        "category": "Code Mark"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codemark.highlightCode",
          "when": "editorHasSelection",
          "group": "codemark@1"
        },
        {
          "command": "codemark.removeHighlight",
          "when": "editorTextFocus",
          "group": "codemark@2"
        },
        {
          "command": "codemark.editTag",
          "when": "editorTextFocus",
          "group": "codemark@3"
        },
        {
          "command": "codemark.changeColor",
          "when": "editorTextFocus",
          "group": "codemark@4"
        },
        {
          "command": "codemark.toggleHighlightBackground",
          "when": "editorTextFocus",
          "group": "codemark@5"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemark-sidebar",
          "title": "Code Mark Highlighter",
          "icon": "resources/devmarks.svg"
        }
      ]
    },
    "views": {
      "codemark-sidebar": [
        {
          "type": "webview",
          "id": "codemark.highlightsPanel",
          "name": "Highlights",
          "icon": "resources/devmarks.svg",
          "contextualTitle": "Code Mark Highlights"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codemark.nextHighlight",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "codemark.prevHighlight",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "codemark.highlightCode",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorHasSelection"
      },
      {
        "command": "codemark.removeHighlight",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "codemark.toggleHighlightBackground",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Code Mark Highlighter",
      "properties": {
        "codemark.storageFile": {
          "type": "string",
          "default": ".vscode/codemark.json",
          "description": "Path (relative to workspace root) where highlights are stored."
        },
        "codemark.fuzzyMatchThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.5,
          "maximum": 1.0,
          "description": "Minimum similarity ratio (0.5–1.0) for fuzzy content matching when re-applying highlights."
        },
        "codemark.highlightOpacity": {
          "type": "number",
          "default": 0.28,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of highlight backgrounds (0 is transparent, 1 is opaque). Also applies to alpha in #RRGGBBAA colors."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
